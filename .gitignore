.svqa-manifest.json
.svqa-manifest.lock
*.svqa-tmp-*

# Editors and OS
.idea/
.vscode/
*.swp
.DS_Store
Thumbs.db

# Local configuration and secrets (this tool needs none; keep it that way)
.env
.env.*
*.pem
*.key
*.p8
